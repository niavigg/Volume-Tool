<?xml version="1.0" encoding="utf-8"?>
<!-- 音量悬浮窗：平时是个小圆（只显示当前音量数字），点一下展开成「− 音量 +」药丸 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 平时：小圆 -->
    <TextView
        android:id="@+id/ovCircle"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/overlay_circle"
        android:gravity="center"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 用时：药丸（点小圆后展开，平时隐藏） -->
    <LinearLayout
        android:id="@+id/ovPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_bg"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/ovDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/overlay_minus"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ovVol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="20dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ovUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/overlay_plus"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>